-- Run this manually after replacing the project URL and storing the service-role
-- key in Supabase Vault. Do not commit a real key.

create extension if not exists pg_cron with schema pg_catalog;
create extension if not exists pg_net with schema extensions;

-- Example Vault setup:
-- select vault.create_secret('https://PROJECT_REF.supabase.co', 'couple_app_project_url');
-- select vault.create_secret('WORKER_SECRET', 'couple_app_worker_secret');

select cron.schedule(
  'couple-app-notification-worker',
  '* * * * *',
  $$
  select net.http_post(
    url := (select decrypted_secret from vault.decrypted_secrets where name = 'couple_app_project_url')
      || '/functions/v1/notification-worker',
    headers := jsonb_build_object(
      'Content-Type', 'application/json',
      'X-Worker-Secret',
        (select decrypted_secret from vault.decrypted_secrets where name = 'couple_app_worker_secret')
    ),
    body := '{}'::jsonb
  );
  $$
);

